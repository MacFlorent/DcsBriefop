<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Version>26.5.22.0</Version>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon256.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Resources\canvas.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon256.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="CoordinateSharp" Version="3.4.1.1" />
    <PackageReference Include="CoordinateSharp.Magnetic" Version="2.1.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="ObjectListView.Repack.NET6Plus" Version="2.9.5" />
    <PackageReference Include="HtmlTags" Version="10.0.0" />
    <PackageReference Include="log4net" Version="3.3.1" />
    <PackageReference Include="Mapsui" Version="5.0.2" />
    <PackageReference Include="Mapsui.Nts" Version="5.0.2" />
    <PackageReference Include="Mapsui.Rendering.Skia" Version="5.0.2" />
    <PackageReference Include="Mapsui.Tiling" Version="5.0.2" />
    <PackageReference Include="Mapsui.WindowsForms" Version="5.0.2" />
    <PackageReference Include="ProjNet" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="UnitsNet" Version="5.75.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\UcBriefingPartTableText.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\UcBriefingPartImage.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\UcBriefingPartWaypoints.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\UcBriefingPartGroups.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\UcBriefingPartAirbases.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\UcBriefingPartParagraph.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- WebView2 ships a WPF assembly (lib_manual/net5.0-windows) that pulls in WindowsBase v5.0.0.0,
       conflicting with the net10.0 framework's v4.0.0.0. This project is WinForms-only, so remove
       the WPF assembly from the reference set before ResolveAssemblyReferences sees it. -->
  <Target Name="RemoveWebView2WpfReference" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /I /Y $(SolutionDir)Resources\Markers $(TargetDir)\Markers&#xD;&#xA;xcopy /I /Y $(SolutionDir)Resources\Routes $(TargetDir)\Routes&#xD;&#xA;xcopy /I /Y $(SolutionDir)Resources\Resources $(TargetDir)\Resources&#xD;&#xA;xcopy /I /Y $(SolutionDir)Resources\Html $(TargetDir)\Html" />
  </Target>

  <Target Name="PublishResourcesAndZip" AfterTargets="Publish">
    <PropertyGroup>
      <_ReleasesDir>$(ProjectDir)bin\published_releases\</_ReleasesDir>
    </PropertyGroup>
    <ItemGroup>
      <_PublishMarkerFiles Include="$(SolutionDir)Resources\Markers\**\*" />
      <_PublishRouteFiles Include="$(SolutionDir)Resources\Routes\**\*" />
      <_PublishResourceFiles Include="$(SolutionDir)Resources\Resources\**\*" />
      <_PublishHtmlFiles Include="$(SolutionDir)Resources\Html\**\*" />
      <_PublishLooseFiles Include="$(SolutionDir)Resources\*.*" />
      <_ExcludedFiles Include="$(PublishDir)**\*.log" />
      <_ExcludedFiles Include="$(PublishDir)**\*.pdb" />
      <_ExcludedFiles Include="$(PublishDir)*.xml" />
    </ItemGroup>

    <Delete Files="@(_ExcludedFiles)" />
    <Exec Command="powershell -NoProfile -Command &quot;Get-ChildItem -Path '$(PublishDir)runtimes' -Directory | Where-Object Name -NotLike 'win-*' | Remove-Item -Recurse -Force&quot;" Condition="Exists('$(PublishDir)runtimes')" />

    <Copy SourceFiles="@(_PublishMarkerFiles)" DestinationFolder="$(PublishDir)Markers\%(RecursiveDir)" />
    <Copy SourceFiles="@(_PublishRouteFiles)" DestinationFolder="$(PublishDir)Routes\%(RecursiveDir)" />
    <Copy SourceFiles="@(_PublishResourceFiles)" DestinationFolder="$(PublishDir)Resources\%(RecursiveDir)" />
    <Copy SourceFiles="@(_PublishHtmlFiles)" DestinationFolder="$(PublishDir)Html\%(RecursiveDir)" />
    <Copy SourceFiles="@(_PublishLooseFiles)" DestinationFolder="$(PublishDir)" />

    <MakeDir Directories="$(_ReleasesDir)" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(_ReleasesDir)DcsBriefop_$(Version).zip" Overwrite="true" />
  </Target>

</Project>